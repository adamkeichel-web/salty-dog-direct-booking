{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salty-dog-direct-booking",
  "main": "worker.js",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin*"],
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": ["0 14 * * *"]
  },
  "d1_databases": [
    {
      "binding": "BOOKINGS_DB",
      "database_name": "salty-dog-bookings",
      "database_id": "898de6f1-fa33-4b2a-9860-a1b9d9ee7e23",
      "migrations_dir": "migrations"
    }
  ]
}
